runs/
/site/

# ========================
#  Standard Python Files
# ========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
*.egg

# Installer logs
pip-log.txt

# Unit test / coverage reports
.pytest_cache/
.coverage
.cache
htmlcov/

# Jupyter Notebook
.ipynb_checkpoints

# mypy, ruff, pyre
.mypy_cache/
.ruff_cache/
.pyre/

# Environments (redundant with project specific, but good to keep)
.env

# PyCharm (already covered by .idea/ below)
# .idea/ is a better general rule
.idea/
/workspace.xml